NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://zimmet:zimmet_password@localhost:5432/zimmet?schema=public

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

CORS_ORIGIN=http://localhost:5173

SEED_ADMIN_EMAIL=admin@zimmet.local
SEED_ADMIN_PASSWORD=Admin123!

# Kurum adı: e-postalarda ve zimmet tutanaklarında görünür
ORGANIZATION_NAME=Kurum Adı
# Web arayüzünün adresi: e-postalardaki bağlantılar için
APP_URL=http://localhost:5173

# E-posta (geliştirmede docker-compose içindeki Mailpit yakalar: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IT Zimmet Sistemi <noreply@zimmet.local>"
