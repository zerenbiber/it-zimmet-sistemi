generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enum'lar ─────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
}

enum DeviceType {
  LAPTOP
  DESKTOP
  SERVER
  MONITOR
  PRINTER
  NETWORK
  PHONE
  TABLET
  PERIPHERAL
  OTHER
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  FAULTY
  IN_REPAIR
  RETIRED
}

enum DeviceEventType {
  CREATED
  UPDATED
  ASSIGNED
  RETURNED
  STATUS_CHANGED
  FAULT_REPORTED
  DELETED
}

// ─── Organizasyon ─────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("departments")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  firstName          String    @map("first_name") @db.VarChar(50)
  lastName           String    @map("last_name") @db.VarChar(50)
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash")
  role               Role      @default(STAFF)
  title              String?   @db.VarChar(100)
  phone              String?   @db.VarChar(20)
  departmentId       String?   @map("department_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  /// Kullanıcı sistemin verdiği geçici şifreyi kullanıyorsa true olur.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  /// "Şifremi unuttum" kodu. Kodun kendisi değil HMAC'i saklanır; 15 dk geçerli, 5 deneme hakkı var.
  resetCodeHash      String?   @map("reset_code_hash") @db.VarChar(128)
  resetCodeExpiresAt DateTime? @map("reset_code_expires_at")
  resetCodeAttempts  Int       @default(0) @map("reset_code_attempts")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  /// Kullanıcı tamamen silinmez, zimmet geçmişi kaybolmasın diye sadece işaretlenir.
  deletedAt          DateTime? @map("deleted_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  refreshTokens       RefreshToken[]
  assignments         Assignment[]   @relation("AssignmentAssignee")
  assignmentsGiven    Assignment[]   @relation("AssignmentAssignedBy")
  assignmentsReceived Assignment[]   @relation("AssignmentReturnedTo")
  deviceEvents        DeviceEvent[]

  @@index([departmentId])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Envanter ─────────────────────────────────────────────────────────────────

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  /// QR koda yazılan demirbaş numarası (ör. IT-2026-00042).
  assetTag        String       @unique @map("asset_tag") @db.VarChar(32)
  type            DeviceType
  brand           String       @db.VarChar(100)
  model           String       @db.VarChar(100)
  serialNumber    String       @unique @map("serial_number") @db.VarChar(100)
  purchaseDate    DateTime     @map("purchase_date") @db.Date
  warrantyEndDate DateTime?    @map("warranty_end_date") @db.Date
  status          DeviceStatus @default(IN_STOCK)
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  /// Cihaz da tamamen silinmez, zimmet geçmişi korunur.
  deletedAt       DateTime?    @map("deleted_at")

  assignments Assignment[]
  events      DeviceEvent[]

  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@map("devices")
}

/// Demirbaş numaraları için yıllık sayaç.
model AssetTagCounter {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("asset_tag_counters")
}

// ─── Zimmet ───────────────────────────────────────────────────────────────────

/// Bir cihaz zaman içinde birçok kez zimmetlenebilir ama aynı anda sadece bir
/// açık zimmeti olabilir (returnedAt boş). Bu kural ilk migration'daki kısmi
/// unique index ile veritabanı seviyesinde korunuyor.
model Assignment {
  id           String    @id @default(uuid()) @db.Uuid
  deviceId     String    @map("device_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  assignedById String    @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignNote   String?   @map("assign_note")
  returnedAt   DateTime? @map("returned_at")
  returnedToId String?   @map("returned_to_id") @db.Uuid
  returnNote   String?   @map("return_note")

  device     Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user       User   @relation("AssignmentAssignee", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User   @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  returnedTo User?  @relation("AssignmentReturnedTo", fields: [returnedToId], references: [id], onDelete: Restrict)

  @@index([deviceId, assignedAt(sort: Desc)])
  @@index([userId, returnedAt])
  @@map("assignments")
}

// ─── Cihaz geçmişi (log) ──────────────────────────────────────────────────────

model DeviceEvent {
  id            String          @id @default(uuid()) @db.Uuid
  deviceId      String          @map("device_id") @db.Uuid
  type          DeviceEventType
  fromStatus    DeviceStatus?   @map("from_status")
  toStatus      DeviceStatus?   @map("to_status")
  description   String?
  performedById String?         @map("performed_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")

  device      Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  performedBy User?  @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([deviceId, createdAt(sort: Desc)])
  @@map("device_events")
}
